{
  "name": "@ceartshamus/sequential-thinking",
  "version": "1.0.0",
  "description": "Claude Agent Skill: work through complex problems in sequential steps with revision, branching, hypothesis generation, and verification, then report a verified conclusion.",
  "keywords": [
    "agent-skill",
    "claude",
    "claude-code",
    "skill",
    "sequential-thinking",
    "reasoning",
    "skillpm"
  ],
  "author": "ceartshamus",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "lint": "npm run lint:md && npm run lint:spec && npm run lint:skill && npm run lint:pkg",
    "lint:md": "markdownlint-cli2",
    "lint:spec": "skills-ref validate skills/sequential-thinking",
    "lint:skill": "skill-validator check --strict skills/sequential-thinking",
    "lint:pkg": "publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceartshamus/sequential-thinking.git"
  },
  "homepage": "https://github.com/ceartshamus/sequential-thinking#readme",
  "bugs": {
    "url": "https://github.com/ceartshamus/sequential-thinking/issues"
  },
  "files": [
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.22.1",
    "publint": "^0.3.21",
    "skills-ref": "^0.1.5"
  }
}
